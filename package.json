{
  "name": "caseflow-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:ui-kit": "npm --prefix ../innovations-ui-kit run build",
    "predev": "npm run build:ui-kit",
    "dev": "vite",
    "prebuild": "npm run build:ui-kit",
    "build": "tsc -b && vite build",
    "pretypecheck": "npm run build:ui-kit",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "innovations-ui-kit": "file:../innovations-ui-kit",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^31.0.1",
    "msw": "^3.0.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
